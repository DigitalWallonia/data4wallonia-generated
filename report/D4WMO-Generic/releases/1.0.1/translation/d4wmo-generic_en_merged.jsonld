    {
      "@id": "http://purl.org/dc/terms/alternative",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "EA-Guid": "{52320F1F-7A7C-4e64-BC29-82DCDF393FA0}",
      "ap-definition-en": {
        "en": "Any name by which a Person is known, other than their full name."
      },
      "ap-label-en": {
        "en": "alternative name"
      },
      "codelist": [],
      "definition": {
        "en": "Any name by which a Person is known, other than their full name."
      },
      "domain": [
        {
          "EA-Name": "Person",
          "uri": "http://www.w3.org/ns/person#Person"
        }
      ],
      "extra": {
        "EA-Domain": "Person",
        "EA-Domain-Guid": "{E444F278-9C73-4871-9290-C9B09FDADCAE}",
        "EA-Guid": "{52320F1F-7A7C-4e64-BC29-82DCDF393FA0}",
        "EA-Name": "internalName",
        "EA-Package": "cv",
        "EA-Range": "Text",
        "EA-Type": "attribute",
        "RangeData": {
          "EA-GUID": "{E4045FE6-F5D2-4c3f-881E-800F8C9AF85E}",
          "EA-Name": "Text",
          "EA-Package": "DataTypes",
          "uri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
        },
        "RawTags": [
          {
            "key": "definition-en",
            "note": "null",
            "value": "Any name by which a Person is known, other than their full name."
          },
          {
            "key": "uri",
            "note": "null",
            "value": "http://purl.org/dc/terms/alternative"
          },
          {
            "key": "usageNote-en",
            "note": "Many individuals use a short form of their name, a 'middle' name as a 'first' name or a professional name. For example, the British politician and former UN High Representative for Bosnia and Herzegovina, Jeremy John Durham Ashdown, Baron Ashdown of Norton-sub-Hamdon, is usually referred to simply as 'Paddy Ashdown' or 'Lord Ashdown.' It is not the role of the alternative name property to record nick names, pet names or other 'familiar names' that will be of no consequence in public sector data exchange. Furthermore, some individuals have more than one legal name in which case the full name property should be used multiple times. Alternative name gives a means of recording names by which an individual is generally known, or professionally known, even though such names are no more than secondary from a legal point of view.",
            "value": "NOTE"
          },
          {
            "key": "label-en",
            "note": "null",
            "value": "alternative name"
          }
        ],
        "Scope": "NOTHING",
        "ap-codelist": "",
        "ap-definition-en": {
          "en": "Any name by which a Person is known, other than their full name."
        },
        "ap-label-en": {
          "en": "alternative name"
        },
        "ap-usageNote-en": "",
        "definition": {
          "en": "Any name by which a Person is known, other than their full name."
        },
        "label": {
          "en": "alternative name"
        },
        "usage": {
          "en": "Many individuals use a short form of their name, a 'middle' name as a 'first' name or a professional name. For example, the British politician and former UN High Representative for Bosnia and Herzegovina, Jeremy John Durham Ashdown, Baron Ashdown of Norton-sub-Hamdon, is usually referred to simply as 'Paddy Ashdown' or 'Lord Ashdown.' It is not the role of the alternative name property to record nick names, pet names or other 'familiar names' that will be of no consequence in public sector data exchange. Furthermore, some individuals have more than one legal name in which case the full name property should be used multiple times. Alternative name gives a means of recording names by which an individual is generally known, or professionally known, even though such names are no more than secondary from a legal point of view."
        }
      },
      "generalization": [],
      "inpackage": "OTHER_PACKAGE",
      "label": {
        "en": "alternative name"
      },
